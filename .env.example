# Copy to `.env` and fill in. `.env` is git-ignored.
# Leave any value blank to keep that half of the app in mock-data mode.

# LTA DataMall -> live bus arrivals, bus stops, train alerts, crowd density.
# Free: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
EXPO_PUBLIC_LTA_ACCOUNT_KEY=

# OneMap -> A-to-B public transport journey planning.
# Free: https://www.onemap.gov.sg/apidocs/register
EXPO_PUBLIC_ONEMAP_EMAIL=
EXPO_PUBLIC_ONEMAP_PASSWORD=
